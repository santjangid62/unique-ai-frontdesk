# ---------------------------------------------------------------------------
# Unique AI Frontdesk - environment variables
# Copy to .env for local development. On Vercel add the same keys in
# Project Settings -> Environment Variables (never commit real values).
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000

# MongoDB (Atlas or any MongoDB connection string)
# Required. For offline experiments set USE_IN_MEMORY_DB=1 instead (downloads a
# large MongoDB binary on first run and loses data when the process stops).
MONGODB_URI=
USE_IN_MEMORY_DB=0

# Auth secrets - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=30m
JWT_REFRESH_DAYS=30

# Allowed browser origin (Vite dev server in development)
CLIENT_ORIGIN=http://localhost:5173

# AI (OpenAI). Without a key the AI runs in grounded fallback mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Voice / WhatsApp providers (Phase 4-5, optional)
TWILIO_AUTH_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=unique-frontdesk-verify

# Set to true only for local bootstrap to allow POST /api/auth/bootstrap-super-admin
ALLOW_SUPER_ADMIN_BOOTSTRAP=false

# Transactional email (Resend HTTP API) - verification codes and password resets
RESEND_API_KEY=
MAIL_FROM=Unique AI Frontdesk <onboarding@resend.dev>
APP_URL=http://localhost:5173
