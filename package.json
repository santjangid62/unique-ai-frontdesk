{
  "name": "unique-ai-frontdesk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Unique AI Frontdesk - multi-tenant AI receptionist SaaS (voice, WhatsApp, website chat, leads, appointments)",
  "engines": {
    "node": ">=20.x"
  },
  "scripts": {
    "dev": "node --watch server/src/index.js",
    "start": "node server/src/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "install:all": "npm install && npm --prefix client install",
    "seed": "node server/src/scripts/seed.js",
    "db:check": "node server/src/scripts/db-check.js",
    "db:local": "node server/src/scripts/local-db.js",
    "atlas:setup": "node server/src/scripts/atlas-setup.js",
    "deploy": "node server/src/scripts/deploy.js",
    "smoke": "node server/src/scripts/smoke.js",
    "test": "node server/test/atlas-mock.test.js && node server/test/vercel-deploy.test.js",
    "test:atlas": "node server/test/atlas-mock.test.js",
    "test:deploy": "node server/test/vercel-deploy.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "pdf-parse": "^1.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.3"
  }
}
