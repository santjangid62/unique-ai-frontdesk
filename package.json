{
  "name": "unique-ai-frontdesk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Unique AI Frontdesk - multi-tenant AI receptionist SaaS (voice, WhatsApp, website chat, leads, appointments)",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --watch --watch-path=server/src server/src/index.js",
    "start": "node server/src/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "install:all": "npm install && npm --prefix client install",
    "seed": "node server/src/scripts/seed.js",
    "demo:data": "node server/src/scripts/demo-data.js",
    "demo:reset": "node server/src/scripts/reset-demo.js",
    "db:check": "node server/src/scripts/db-check.js",
    "db:local": "node server/src/scripts/local-db.js",
    "atlas:setup": "node server/src/scripts/atlas-setup.js",
    "deploy": "node server/src/scripts/deploy.js",
    "smoke": "node server/src/scripts/smoke.js",
    "smoke:ci": "node server/src/scripts/smoke-ci.js",
    "verify:hindi": "node server/src/scripts/verify-hindi.js",
    "pdf:build": "node server/src/scripts/build-setup-pdf.js",
    "lock:check": "npm ci --dry-run --ignore-scripts && npm --prefix client ci --dry-run --ignore-scripts",
    "test": "node server/test/atlas-mock.test.js && node server/test/vercel-deploy.test.js && node server/test/demo-credentials.test.js && node server/test/docs-pdf.test.js && node server/test/preview-db-guard.test.js && node server/test/preview-urls.test.js && node server/test/integration-check.test.js && node server/test/whatsapp-webhook.test.js",
    "test:atlas": "node server/test/atlas-mock.test.js",
    "test:deploy": "node server/test/vercel-deploy.test.js",
    "test:credentials": "node server/test/demo-credentials.test.js",
    "test:docs-pdf": "node server/test/docs-pdf.test.js",
    "test:preview-guard": "node server/test/preview-db-guard.test.js",
    "test:preview-urls": "node server/test/preview-urls.test.js",
    "test:integrations": "node server/test/integration-check.test.js",
    "test:whatsapp": "node server/test/whatsapp-webhook.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "pdf-parse": "^1.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.3"
  }
}
